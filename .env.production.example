# Example only. Provide the real runtime URL through the deployment's secret store.
NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://event_dynamics_runtime:replace_with_runtime_password@db.example.invalid:5432/event_dynamics

# Conservative per-process starting values. Review total connections across
# every pool and replica against the database budget before deployment.
DB_POOL_MAX=5
DB_CONNECTION_TIMEOUT_MS=5000

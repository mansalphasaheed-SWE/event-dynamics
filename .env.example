#.env.example
NODE_ENV=development
PORT=3000
POSTGRES_USER=event_dynamics_user
POSTGRES_PASSWORD=replace_with_secure_password
POSTGRES_DB=event_dynamics_database

# API runtime connection. Replace the placeholder with the runtime password.
DATABASE_URL=postgresql://event_dynamics_runtime:replace_with_runtime_password@127.0.0.1:5433/event_dynamics_dev
DB_POOL_MAX=5
DB_CONNECTION_TIMEOUT_MS=5000
